<%# SERGIO 2026-09-17: listado de operadores con activar/desactivar. %>
<%- include('../../partials/header', { titulo: 'Operadores' }) %>
<h1>Operadores</h1>
<p><a class="boton" href="/admin/operadores/nuevo">+ Nuevo operador</a></p>
<div class="tabla-wrap">
<table>
<thead><tr><th>Nombre</th><th>Estado</th><th></th></tr></thead>
<tbody>
<% operadores.forEach(function(o) { %>
  <tr class="<%= o.activo ? '' : 'inactivo' %>">
    <td><%= o.nombre %></td>
    <td><span class="pill <%= o.activo ? 'pill-verde' : 'pill-gris' %>"><%= o.activo ? 'Activo' : 'Inactivo' %></span></td>
    <td class="acciones">
      <a class="enlace-accion" href="/admin/operadores/<%= o.id %>/editar"><span class="texto-completo">editar</span><span class="texto-corto">E</span></a>
      <form style="display:inline" method="POST" action="/admin/operadores/<%= o.id %>/toggle-activo">
        <button type="submit" class="secundario <%= o.activo ? 'boton-desactivar' : 'boton-activar' %>" style="padding:2px 8px;font-size:12px;">
          <span class="texto-completo"><%= o.activo ? 'desactivar' : 'activar' %></span><span class="texto-corto"><%= o.activo ? 'D' : 'A' %></span>
        </button>
      </form>
    </td>
  </tr>
<% }) %>
</tbody>
</table>
</div>
<%- include('../../partials/footer') %>
