<%# SERGIO 2026-09-18: listado de usuarios tecnicos y administrativos. La cuenta de %>
<%# administrador no se administra aqui, se maneja por variable de entorno en Cloudways. %>
<%- include('../../partials/header', { titulo: 'Usuarios' }) %>
<h1>Usuarios</h1>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
<p><a class="boton" href="/admin/usuarios/nuevo">+ Nuevo usuario</a></p>
<div class="tabla-wrap">
<table>
<thead><tr><th>Nombre</th><th class="solo-desktop">Email</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
<tbody>
<% usuarios.forEach(function(u) { %>
  <tr class="<%= u.activo ? '' : 'inactivo' %>">
    <td><%= u.nombre %></td>
    <td class="solo-desktop"><%= u.email %></td>
    <td><%= u.rol === 'administrativo' ? 'Administrativo' : 'Tecnico' %></td>
    <td><span class="pill <%= u.activo ? 'pill-verde' : 'pill-gris' %>"><%= u.activo ? 'Activo' : 'Inactivo' %></span></td>
    <td class="acciones">
      <a class="enlace-accion" href="/admin/usuarios/<%= u.id %>/editar"><span class="texto-completo">editar</span><span class="texto-corto">E</span></a>
      <form style="display:inline" method="POST" action="/admin/usuarios/<%= u.id %>/toggle-activo">
        <button type="submit" class="secundario <%= u.activo ? 'boton-desactivar' : 'boton-activar' %>" style="padding:2px 8px;font-size:12px;">
          <span class="texto-completo"><%= u.activo ? 'desactivar' : 'activar' %></span><span class="texto-corto"><%= u.activo ? 'D' : 'A' %></span>
        </button>
      </form>
    </td>
  </tr>
<% }) %>
<% if (usuarios.length === 0) { %>
  <tr><td colspan="5">No hay tecnicos ni administrativos creados todavia.</td></tr>
<% } %>
</tbody>
</table>
</div>
<%- include('../../partials/footer') %>
