<%# SERGIO 2026-09-17: listado de productos con activar/desactivar. %>
<%- include('../../partials/header', { titulo: 'Productos' }) %>
<h1>Productos</h1>
<p><a class="boton" href="/admin/productos/nuevo">+ Nuevo producto</a></p>
<div class="tabla-wrap">
<table>
<thead><tr><th>Nombre</th><th>Tipo de servicio</th><th>Componente</th><th>Registro ISP</th><th>Estado</th><th></th></tr></thead>
<tbody>
<% productos.forEach(function(p) { %>
  <tr class="<%= p.activo ? '' : 'inactivo' %>">
    <td><%= p.nombre %></td>
    <td><%= p.tipo_servicio_nombre %></td>
    <td><%= p.componente_principal || '' %></td>
    <td><%= p.registro_isp || '' %></td>
    <td><%= p.activo ? 'Activo' : 'Inactivo' %></td>
    <td class="acciones">
      <a href="/admin/productos/<%= p.id %>/editar">editar</a>
      <form style="display:inline" method="POST" action="/admin/productos/<%= p.id %>/toggle-activo">
        <button type="submit" class="secundario" style="padding:2px 8px;font-size:12px;">
          <%= p.activo ? 'desactivar' : 'activar' %>
        </button>
      </form>
    </td>
  </tr>
<% }) %>
</tbody>
</table>
</div>
<%- include('../../partials/footer') %>
