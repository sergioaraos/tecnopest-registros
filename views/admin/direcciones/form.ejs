<%# SERGIO 2026-09-17: formulario para crear/editar una direccion de un cliente. %>
<%- include('../../partials/header', { titulo: direccion.id ? 'Editar direccion' : 'Nueva direccion' }) %>
<h1><%= direccion.id ? 'Editar direccion' : 'Nueva direccion' %> - <%= cliente.razon_social %></h1>
<% if (error) { %><div class="error"><%= error %></div><% } %>
<form class="formulario" method="POST" action="<%= direccion.id ? '/admin/clientes/' + cliente.id + '/direcciones/' + direccion.id : '/admin/clientes/' + cliente.id + '/direcciones' %>">
  <label>Nombre / etiqueta</label>
  <input type="text" name="nombre" value="<%= direccion.nombre || '' %>" placeholder="Ej: Casa matriz, Sucursal Cerrillos">

  <label>Direccion (linea 1) *</label>
  <input type="text" name="direccion_linea_1" value="<%= direccion.direccion_linea_1 || '' %>" required>

  <label>Direccion (linea 2)</label>
  <input type="text" name="direccion_linea_2" value="<%= direccion.direccion_linea_2 || '' %>">

  <label>Comuna</label>
  <input type="text" name="comuna" value="<%= direccion.comuna || '' %>">

  <div class="botones">
    <button type="submit">Guardar</button>
    <a class="boton secundario" href="/admin/clientes/<%= cliente.id %>/direcciones">Cancelar</a>
  </div>
</form>
<%- include('../../partials/footer') %>
