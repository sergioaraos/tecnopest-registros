<%# SERGIO 2026-09-17: formulario para crear/editar un operador. %>
<%- include('../../partials/header', { titulo: operador.id ? 'Editar operador' : 'Nuevo operador' }) %>
<h1><%= operador.id ? 'Editar operador' : 'Nuevo operador' %></h1>
<% if (error) { %><div class="error"><%= error %></div><% } %>
<form class="formulario" method="POST" action="<%= operador.id ? '/admin/operadores/' + operador.id : '/admin/operadores' %>">
  <label>Nombre *</label>
  <input type="text" name="nombre" value="<%= operador.nombre || '' %>" required>
  <div class="botones">
    <button type="submit">Guardar</button>
    <a class="boton secundario" href="/admin/operadores">Cancelar</a>
  </div>
</form>
<%- include('../../partials/footer') %>
