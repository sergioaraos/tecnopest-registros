<%# SERGIO 2026-09-17: layout compartido de las pantallas del tecnico, mismo estilo visual que %>
<%# el panel de administracion pero con su propia navegacion. %>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titulo %> - TecnoPest Registros</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 0; background: #f5f5f5; color: #222; }
  nav { background: #1b5e20; padding: 12px 16px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  nav a { color: #fff; text-decoration: none; font-size: 14px; }
  nav a:hover { text-decoration: underline; }
  nav .marca { font-weight: bold; margin-right: 16px; }
  main { max-width: 700px; margin: 0 auto; padding: 16px; }
  h1 { font-size: 20px; }
  h2 { font-size: 16px; margin-top: 24px; }
  table { width: 100%; border-collapse: collapse; background: #fff; }
  th, td { padding: 8px; border-bottom: 1px solid #ddd; text-align: left; font-size: 14px; }
  .tabla-wrap { overflow-x: auto; }
  .tarjeta { background: #fff; padding: 16px; border-radius: 4px; margin-bottom: 12px; }
  label { display: block; margin-top: 10px; font-size: 14px; font-weight: bold; }
  input, select, textarea {
    width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; font-size: 14px;
  }
  .botones { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
  button, .boton {
    background: #1b5e20; color: #fff; border: none; padding: 10px 16px; border-radius: 4px;
    cursor: pointer; text-decoration: none; font-size: 14px; display: inline-block;
  }
  button.secundario, .boton.secundario { background: #757575; }
  button.peligro { background: #b71c1c; }
  .error { background: #ffebee; color: #b71c1c; padding: 8px 12px; margin-bottom: 12px; border-radius: 4px; font-size: 14px; }
  .aviso { background: #fff8e1; color: #8d6e00; padding: 8px 12px; margin-bottom: 12px; border-radius: 4px; font-size: 14px; }
  .estado-pendiente { color: #b71c1c; font-weight: bold; }
  .estado-sincronizado { color: #1b5e20; font-weight: bold; }
  .linea-producto { border: 1px solid #ddd; padding: 10px; margin-top: 8px; border-radius: 4px; }
  .checklist label { font-weight: normal; display: flex; align-items: center; gap: 6px; margin-top: 6px; }
  .checklist input { width: auto; margin: 0; }
  canvas.firma { border: 1px dashed #999; width: 100%; height: 160px; touch-action: none; background: #fff; }
</style>
</head>
<body>
<nav>
  <span class="marca">TecnoPest</span>
  <a href="/tecnico">Mis registros</a>
  <a href="/tecnico/nuevo">Nuevo registro</a>
  <form method="POST" action="/logout" style="margin-left:auto;display:inline">
    <button type="submit" style="background:none;border:none;color:#fff;text-decoration:underline;cursor:pointer;font-size:14px;padding:0;">Cerrar sesion</button>
  </form>
</nav>
<main>
