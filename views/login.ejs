<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Iniciar sesion - TecnoPest Registros</title>
<style>
  body { font-family: system-ui, sans-serif; background: #f5f5f5; margin: 0; display: flex; min-height: 100vh; align-items: center; justify-content: center; }
  .caja { background: #fff; padding: 24px; border-radius: 6px; width: 100%; max-width: 340px; box-sizing: border-box; }
  h1 { font-size: 18px; margin-top: 0; }
  label { display: block; margin-top: 12px; font-size: 14px; font-weight: bold; }
  input { width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; font-size: 14px; }
  button { margin-top: 18px; width: 100%; background: #1b5e20; color: #fff; border: none; padding: 10px; border-radius: 4px; font-size: 14px; cursor: pointer; }
  .error { background: #ffebee; color: #b71c1c; padding: 8px 12px; margin-bottom: 12px; border-radius: 4px; font-size: 14px; }
</style>
</head>
<body>
<div class="caja">
  <h1>TecnoPest Registros</h1>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="/login">
    <label>Email</label>
    <input type="email" name="email" required autofocus>
    <label>Contrasena</label>
    <input type="password" name="password" required>
    <button type="submit">Ingresar</button>
  </form>
</div>
</body>
</html>
