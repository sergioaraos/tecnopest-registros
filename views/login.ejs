<!-- SERGIO 2026-09-17: pagina de login para usar el panel desde el navegador -->
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Iniciar sesion - TecnoPest Registros</title>
<style>
  <%# SERGIO 2026-09-17: fondo oscuro (como en la firma de correo) para que el logo con
  degradado verde de la "t" se vea con buen contraste. %>
  body {
    font-family: system-ui, sans-serif; background: #121212; margin: 0; display: flex;
    flex-direction: column; min-height: 100vh; align-items: center; justify-content: center;
  }
  .caja { background: #fff; padding: 28px; border-radius: 10px; width: 100%; max-width: 340px; box-sizing: border-box; box-shadow: 0 8px 24px rgba(0,0,0,0.35); }
  h1 { font-size: 18px; margin-top: 0; }
  label { display: block; margin-top: 12px; font-size: 14px; font-weight: bold; }
  input { width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; font-size: 14px; }
  <%# SERGIO 2026-09-17: verde degradado tomado del logo real de TecnoPest (la "t"). %>
  button {
    margin-top: 18px; width: 100%; background: linear-gradient(135deg, #8fd85b, #2ea34a);
    color: #0d2818; font-weight: 600; border: none; padding: 11px; border-radius: 6px;
    font-size: 14px; cursor: pointer; transition: transform 0.1s ease;
  }
  button:hover { transform: translateY(-1px); }
  .error { background: #ffebee; color: #b71c1c; padding: 8px 12px; margin-bottom: 12px; border-radius: 4px; font-size: 14px; }
</style>
</head>
<body>
<div class="caja">
  <img src="/img/logo.png" alt="TecnoPest" style="height:64px;display:block;margin:0 auto 12px;">
  <h1 style="text-align:center;">Registros</h1>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="/login">
    <label>Email</label>
    <input type="email" name="email" required autofocus>
    <label>Contrasena</label>
    <input type="password" name="password" required>
    <button type="submit">Ingresar</button>
  </form>
</div>
<footer style="text-align:center;font-size:11px;color:#888;padding:12px;">
  <%# SERGIO 2026-09-17: se agrega la hora de inicio del servidor ademas del commit, porque
  en Cloudways no hay carpeta .git y el commit siempre sale "desconocido"; la hora si cambia
  en cada despliegue y sirve para confirmar que un redeploy quedo activo. %>
  Version <%= typeof version !== 'undefined' ? version : 'desconocida' %> (servidor iniciado <%= typeof inicioServidor !== 'undefined' ? inicioServidor : 'desconocido' %>)
</footer>
</body>
</html>
